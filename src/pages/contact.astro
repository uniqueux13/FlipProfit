---
import Layout from '../layouts/Layout.astro';

const seoTitle = "Contact Us - FlipProfit Support";
const seoDescription = "Get help with FlipProfit. Join our Discord community or email our team.";
const canonicalURL = "https://flipprofit.online/contact";
---

<Layout title={seoTitle} description={seoDescription} canonical={canonicalURL}>
  <main class="py-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-12">
        <h1 class="text-4xl sm:text-5xl font-bold text-slate-dark dark:text-slate-100 mb-4">
          Get Help
        </h1>
        <p class="text-xl text-gray-600 dark:text-slate-400">
          We're here to help you buy and sell with confidence
        </p>
      </div>

      <!-- Contact Options Grid -->
      <div class="grid md:grid-cols-2 gap-8 mb-12">
        <!-- Discord Community -->
        <div class="bg-gradient-to-br from-[#5865F2]/10 to-white dark:from-[#5865F2]/20 dark:to-slate-800 border-2 border-[#5865F2]/20 dark:border-[#5865F2]/40 rounded-2xl p-8 hover:shadow-lg transition-shadow">
          <div class="flex items-center gap-3 mb-4">
            <svg class="w-10 h-10 text-[#5865F2]" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20.317 4.37a19.791 19.791 0 00-4.885-1.515.074.074 0 00-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 00-5.487 0 12.64 12.64 0 00-.617-1.25.077.077 0 00-.079-.037A19.736 19.736 0 003.677 4.37a.07.07 0 00-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 00.031.057 19.9 19.9 0 005.993 3.03.078.078 0 00.084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 00-.041-.106 13.107 13.107 0 01-1.872-.892.077.077 0 01-.008-.128 10.2 10.2 0 00.372-.292.074.074 0 01.077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 01.078.01c.12.098.246.198.373.292a.077.077 0 01-.006.127 12.299 12.299 0 01-1.873.892.077.077 0 00-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 00.084.028 19.839 19.839 0 006.002-3.03.077.077 0 00.032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 00-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
            </svg>
            <h2 class="text-2xl font-bold text-slate-dark dark:text-slate-100">Join Discord</h2>
          </div>
          <p class="text-gray-700 dark:text-slate-300 mb-6">
            Chat with other buyers and sellers, get quick answers, and connect with the FlipProfit community.
          </p>
          <ul class="space-y-2 text-gray-700 dark:text-slate-300 mb-6">
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-primary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <span>Fastest response time</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-primary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <span>Learn from the community</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-primary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <span>Share your wins</span>
            </li>
          </ul>
          <a
            href="https://discord.gg/nYj3UzdJ"
            target="_blank"
            rel="noopener noreferrer"
            class="block text-center px-6 py-3 bg-[#5865F2] text-white rounded-lg font-semibold hover:bg-[#4752C4] transition-colors shadow-md hover:shadow-lg"
          >
            Join Discord Community
          </a>
        </div>

        <!-- Email Support -->
        <div class="bg-gradient-to-br from-primary/10 to-white dark:to-slate-800 border-2 border-primary/30 rounded-2xl p-8 hover:shadow-lg transition-shadow">
          <div class="flex items-center gap-3 mb-4">
            <svg class="w-10 h-10 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
            <h2 class="text-2xl font-bold text-slate-dark dark:text-slate-100">Email Us</h2>
          </div>
          <p class="text-gray-700 dark:text-slate-300 mb-6">
            For account issues, billing questions, or detailed support requests.
          </p>
          <ul class="space-y-2 text-gray-700 dark:text-slate-300 mb-6">
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-primary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <span>Response within 24 hours</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-primary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <span>Detailed troubleshooting</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-primary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <span>Account &amp; billing support</span>
            </li>
          </ul>
          <a
            href="mailto:team@flipprofit.online"
            class="block text-center px-6 py-3 bg-primary text-primary-foreground rounded-lg font-semibold hover:bg-primary/90 transition-colors shadow-md hover:shadow-lg"
          >
            Email team@flipprofit.online
          </a>
        </div>
      </div>

      <!-- Common Questions -->
      <div class="bg-slate-light dark:bg-slate-800/50 rounded-2xl p-8">
        <h2 class="text-xl font-bold text-slate-dark dark:text-slate-100 mb-4">Before You Reach Out</h2>
        <p class="text-gray-700 dark:text-slate-300 mb-4">
          Check our <a href="/#faq" class="text-primary font-semibold hover:underline">FAQ</a> for answers to common questions about:
        </p>
        <ul class="grid md:grid-cols-2 gap-3 text-gray-700 dark:text-slate-300">
          <li class="flex items-start gap-2">
            <svg class="w-5 h-5 text-primary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            <span>Buying and selling on the marketplace</span>
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-5 h-5 text-primary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            <span>Pricing and billing</span>
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-5 h-5 text-primary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            <span>Shipping and payouts</span>
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-5 h-5 text-primary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            <span>Refunds and cancellations</span>
          </li>
        </ul>
      </div>
    </div>
  </main>
</Layout>
