---
import '../styles/global.css';
import ScarcityBanner from '../components/ScarcityBanner.astro';

const seoTitle = "FlipProfit - Scale Your Reselling Business with AI Automation";
const seoDescription = "The all-in-one SaaS platform for scaling reselling businesses through inventory automation, cross-listing management, and profit analytics.";
const canonicalURL = "https://flipprofit.online";

const atomicAnswer = "Scaling a reselling business requires implementing automation across inventory management, cross-platform listing, and sourcing workflows. Successful resellers systematize profit tracking, SKU organization, and multi-marketplace operations to reduce manual overhead. Tools like FlipProfit enable this automation through centralized inventory control, bulk listing capabilities, and real-time analytics, allowing resellers to expand inventory volume without proportional time investment.";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{seoTitle}</title>
    <meta name="description" content={seoDescription} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:image" content={`${canonicalURL}/images/logo.png`} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seoTitle} />
    <meta name="twitter:description" content={seoDescription} />
    <meta name="twitter:image" content={`${canonicalURL}/images/logo.png`} />

    <!-- JSON-LD Schema: SoftwareApplication -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "FlipProfit",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web, iOS, Android",
      "description": seoDescription,
      "offers": {
        "@type": "Offer",
        "price": "0.00",
        "priceCurrency": "USD"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.8",
        "ratingCount": "150"
      }
    })} />

    <!-- JSON-LD Schema: FAQPage -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [{
        "@type": "Question",
        "name": "How do I scale my reselling business?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": atomicAnswer
        }
      }]
    })} />
  </head>

  <body class="bg-white">
    <!-- Scarcity Banner -->
    <ScarcityBanner />

    <!-- Hero Section -->
    <div class="min-h-screen flex flex-col">
      <!-- Header -->
      <header class="py-6 px-4 sm:px-6 lg:px-8">
        <div class="max-w-7xl mx-auto flex justify-between items-center">
          <div class="flex items-center gap-3">
            <img src="/images/logo-small.png" alt="FlipProfit Logo" class="w-12 h-12" />
            <span class="font-coiny text-2xl text-slate-dark">FlipProfit</span>
          </div>
          <a
            href="https://app.flipprofit.online/signup"
            class="px-6 py-2 bg-emerald text-white rounded-lg font-medium hover:bg-emerald-600 transition-colors"
          >
            Get Started
          </a>
        </div>
      </header>

      <!-- Hero Content -->
      <main class="flex-1 px-4 sm:px-6 lg:px-8 py-12 lg:py-20">
        <div class="max-w-7xl mx-auto">
          <div class="grid lg:grid-cols-2 gap-12 items-center">
            <!-- Left Column: Text Content -->
            <div>
              <div class="inline-block px-3 py-1 bg-emerald-100 text-emerald-700 rounded-full text-sm font-medium mb-6">
                The Operating System for the Modern Reseller
              </div>

              <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-slate-dark leading-tight mb-6">
                Scale Your Reselling Business with <span class="text-emerald">AI Automation</span>
              </h1>

              <p class="text-lg text-gray-600 mb-8">
                Reselling is about finding value, not fighting spreadsheets. FlipProfit handles the math so you can stay in the flow.
              </p>

              <!-- Value Propositions -->
              <div class="space-y-4 mb-10">
                <div class="flex items-start gap-3">
                  <svg class="w-6 h-6 text-emerald flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <div>
                    <h3 class="font-semibold text-slate-dark">Scout at the Store</h3>
                    <p class="text-gray-600">AI instantly tells you which items are worth buying</p>
                  </div>
                </div>

                <div class="flex items-start gap-3">
                  <svg class="w-6 h-6 text-emerald flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <div>
                    <h3 class="font-semibold text-slate-dark">List in Seconds</h3>
                    <p class="text-gray-600">AI writes titles, descriptions, and suggests prices</p>
                  </div>
                </div>

                <div class="flex items-start gap-3">
                  <svg class="w-6 h-6 text-emerald flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <div>
                    <h3 class="font-semibold text-slate-dark">Track Every Dollar</h3>
                    <p class="text-gray-600">Real-time profit tracking with tax-ready reports</p>
                  </div>
                </div>
              </div>

              <!-- CTA Buttons -->
              <div class="flex flex-col sm:flex-row gap-4">
                <a
                  href="https://app.flipprofit.online/signup"
                  class="inline-flex items-center justify-center px-8 py-4 bg-emerald text-white rounded-lg font-semibold text-lg hover:bg-emerald-600 transition-colors shadow-lg hover:shadow-xl"
                >
                  Start Free Today
                  <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                  </svg>
                </a>
                <a
                  href="#features"
                  class="inline-flex items-center justify-center px-8 py-4 bg-white text-slate-dark border-2 border-slate-dark rounded-lg font-semibold text-lg hover:bg-slate-light transition-colors"
                >
                  See How It Works
                </a>
              </div>
            </div>

            <!-- Right Column: Logo Image -->
            <div class="flex justify-center lg:justify-end">
              <div class="relative">
                <img
                  src="/images/logo.png"
                  alt="FlipProfit - AI-Powered Reseller Command Center"
                  class="w-80 h-80 lg:w-96 lg:h-96 drop-shadow-2xl animate-float"
                />
              </div>
            </div>
          </div>
        </div>
      </main>
    </div>

    <!-- SEO Content Section: How to Scale a Reselling Business -->
    <section id="features" class="py-16 px-4 sm:px-6 lg:px-8 bg-slate-light">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl sm:text-4xl font-bold text-slate-dark mb-6 text-center">
          How to Scale a Reselling Business
        </h2>

        <!-- Atomic Answer for Featured Snippet -->
        <div class="bg-white rounded-xl p-8 shadow-lg mb-12">
          <p class="text-lg text-gray-700 leading-relaxed">
            Scaling a reselling business requires implementing <strong class="text-emerald">automation</strong> across inventory management, cross-platform listing, and <strong class="text-emerald">sourcing</strong> workflows. Successful resellers systematize profit tracking, SKU organization, and multi-marketplace operations to reduce manual overhead. Tools like <strong class="text-emerald">FlipProfit</strong> enable this automation through centralized inventory control, bulk listing capabilities, and real-time analytics, allowing resellers to expand inventory volume without proportional time investment.
          </p>
        </div>

        <!-- Feature Grid -->
        <div class="grid md:grid-cols-3 gap-8">
          <div class="bg-white rounded-lg p-6 shadow-md">
            <div class="w-12 h-12 bg-emerald-100 rounded-lg flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-emerald" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-slate-dark mb-2">Automated Inventory</h3>
            <p class="text-gray-600">Centralized dashboard tracks all items across platforms with automatic syncing</p>
          </div>

          <div class="bg-white rounded-lg p-6 shadow-md">
            <div class="w-12 h-12 bg-emerald-100 rounded-lg flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-emerald" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-slate-dark mb-2">AI-Powered Sourcing</h3>
            <p class="text-gray-600">Scan items in-store and get instant profit calculations before you buy</p>
          </div>

          <div class="bg-white rounded-lg p-6 shadow-md">
            <div class="w-12 h-12 bg-emerald-100 rounded-lg flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-emerald" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-slate-dark mb-2">Real-Time Analytics</h3>
            <p class="text-gray-600">Track profit margins, fees, and ROI across all marketplaces in one place</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Waitlist/CTA Section -->
    <section id="waitlist" class="py-20 px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl sm:text-4xl font-bold text-slate-dark mb-4">
          Ready to Scale Your Business?
        </h2>
        <p class="text-xl text-gray-600 mb-8">
          Join hundreds of resellers automating their operations with FlipProfit
        </p>

        <div class="bg-slate-light rounded-2xl p-8">
          <div class="max-w-md mx-auto">
            <a
              href="https://app.flipprofit.online/signup"
              class="inline-flex items-center justify-center w-full px-8 py-4 bg-emerald text-white rounded-lg font-semibold text-lg hover:bg-emerald-600 transition-colors shadow-lg hover:shadow-xl"
            >
              Get Started Free
              <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
              </svg>
            </a>
            <p class="text-sm text-gray-500 mt-4 text-center">
              No credit card required. Start with 5 free AI scans per month.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="py-8 px-4 sm:px-6 lg:px-8 bg-slate-dark text-white">
      <div class="max-w-7xl mx-auto text-center">
        <div class="flex items-center justify-center gap-3 mb-4">
          <img src="/images/logo-small.png" alt="FlipProfit" class="w-8 h-8" />
          <span class="font-coiny text-xl">FlipProfit</span>
        </div>
        <p class="text-gray-400">
          &copy; {new Date().getFullYear()} FlipProfit. All rights reserved.
        </p>
      </div>
    </footer>

    <style>
      @keyframes float {
        0%, 100% {
          transform: translateY(0px);
        }
        50% {
          transform: translateY(-20px);
        }
      }

      .animate-float {
        animation: float 6s ease-in-out infinite;
      }
    </style>
  </body>
</html>
