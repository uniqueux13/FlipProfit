---
import '../styles/global.css';
import ScarcityBanner from '../components/ScarcityBanner.astro';

const seoTitle = "FlipProfit - Scale Your Reselling Business with AI Automation";
const seoDescription = "The all-in-one SaaS platform for scaling reselling businesses through inventory automation, cross-listing management, and profit analytics.";
const canonicalURL = "https://flipprofit.online";

const atomicAnswer = "Scaling a reselling business requires implementing automation across inventory management, cross-platform listing, and sourcing workflows. Successful resellers systematize profit tracking, SKU organization, and multi-marketplace operations to reduce manual overhead. Tools like FlipProfit enable this automation through centralized inventory control, bulk listing capabilities, and real-time analytics, allowing resellers to expand inventory volume without proportional time investment.";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{seoTitle}</title>
    <meta name="description" content={seoDescription} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:image" content={`${canonicalURL}/images/logo.png`} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seoTitle} />
    <meta name="twitter:description" content={seoDescription} />
    <meta name="twitter:image" content={`${canonicalURL}/images/logo.png`} />

    <!-- JSON-LD Schema: SoftwareApplication -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "FlipProfit",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web, iOS, Android",
      "description": seoDescription,
      "offers": {
        "@type": "Offer",
        "price": "0.00",
        "priceCurrency": "USD"
      }
    })} />

    <!-- JSON-LD Schema: FAQPage -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [{
        "@type": "Question",
        "name": "How do I scale my reselling business?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": atomicAnswer
        }
      }]
    })} />
  </head>

  <body class="bg-white">
    <!-- Sticky Navigation -->
    <nav class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm border-b border-slate-200 shadow-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">
          <div class="flex items-center gap-3">
            <img src="/images/logo-small.png" alt="FlipProfit Logo" class="w-10 h-10" />
            <span class="font-coiny text-xl text-slate-dark">FlipProfit</span>
          </div>

          <!-- Desktop Navigation -->
          <div class="hidden md:flex items-center gap-6">
            <a href="#proof" class="text-sm font-medium text-slate-600 hover:text-emerald-600 transition-colors">Proof</a>
            <a href="#founding-members" class="text-sm font-medium text-slate-600 hover:text-emerald-600 transition-colors">Pricing</a>
            <a href="#features" class="text-sm font-medium text-slate-600 hover:text-emerald-600 transition-colors">Features</a>
            <a href="#faq" class="text-sm font-medium text-slate-600 hover:text-emerald-600 transition-colors">FAQ</a>
            <a
              href="https://app.flipprofit.online/signup"
              class="px-5 py-2 bg-emerald text-white rounded-lg font-semibold text-sm hover:bg-emerald-600 transition-colors shadow-sm"
            >
              Start Free Today
            </a>
          </div>

          <!-- Mobile CTA -->
          <div class="md:hidden">
            <a
              href="https://app.flipprofit.online/signup"
              class="px-4 py-2 bg-emerald text-white rounded-lg font-semibold text-sm hover:bg-emerald-600 transition-colors"
            >
              Start Free
            </a>
          </div>
        </div>
      </div>
    </nav>

    <!-- Hero Section -->
    <div class="min-h-screen flex flex-col">
      <!-- Hero Content (header removed, now using sticky nav) -->

      <!-- Hero Content -->
      <main class="flex-1 px-4 sm:px-6 lg:px-8 py-8 lg:py-12">
        <div class="max-w-7xl mx-auto">
          <div class="grid lg:grid-cols-2 gap-12 items-center">
            <!-- Left Column: Text Content -->
            <div>
              <div class="inline-block px-3 py-1 bg-emerald-100 text-emerald-700 rounded-full text-sm font-medium mb-6">
                Used by resellers moving 50+ items/month
              </div>

              <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-slate-dark leading-tight mb-6">
                Know What to Buy <span class="text-emerald">Before You Buy It</span>
              </h1>

              <p class="text-lg text-gray-600 mb-8">
                Scan any barcode and see 30-day sales history, profit margins, and sell-through rates in 2 seconds. Stop guessing, start scaling.
              </p>

              <!-- Value Propositions -->
              <div class="space-y-4 mb-10">
                <div class="flex items-start gap-3">
                  <svg class="w-6 h-6 text-emerald flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <div>
                    <h3 class="font-semibold text-slate-dark">Scan → See eBay/Amazon Data → Decide in 2 Seconds</h3>
                    <p class="text-gray-600">Real sales data, not guesswork. See what items actually sold for in the last 30 days</p>
                  </div>
                </div>

                <div class="flex items-start gap-3">
                  <svg class="w-6 h-6 text-emerald flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <div>
                    <h3 class="font-semibold text-slate-dark">Auto-Generated Listings with AI Titles</h3>
                    <p class="text-gray-600">Upload a photo, get SEO-optimized titles and descriptions. Copy-paste to eBay, Mercari, Poshmark</p>
                  </div>
                </div>

                <div class="flex items-start gap-3">
                  <svg class="w-6 h-6 text-emerald flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <div>
                    <h3 class="font-semibold text-slate-dark">Profit Tracking Across All Platforms</h3>
                    <p class="text-gray-600">Sync eBay sales automatically. Track COGS, fees, and net profit per item. Export for taxes</p>
                  </div>
                </div>
              </div>

              <!-- CTA Button -->
              <div>
                <a
                  href="https://app.flipprofit.online/signup"
                  class="inline-flex items-center justify-center px-8 py-4 bg-emerald text-white rounded-lg font-semibold text-lg hover:bg-emerald-600 transition-colors shadow-lg hover:shadow-xl"
                >
                  Start Free Today - 5 Scans Included
                  <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                  </svg>
                </a>
                <p class="text-sm text-gray-500 mt-3">
                  No credit card required • 5 free scans to start
                </p>
              </div>
            </div>

            <!-- Right Column: Operational Demo -->
            <div class="flex justify-center lg:justify-end">
              <div class="relative">
                <!-- Product screenshot -->
                <div class="overflow-hidden rounded-2xl shadow-2xl border-4 border-emerald-200 bg-white">
                  <img
                    src="/images/profit-calc-screenshot.jpg"
                    alt="FlipProfit dashboard showing real-time sales data, profit margins, and sell-through rates"
                    loading="eager"
                    decoding="async"
                    class="w-full max-w-xs lg:max-w-sm"
                  />
                </div>
              </div>
            </div>
          </div>
        </div>
      </main>
    </div>

    <!-- Social Proof Section -->
    <section id="proof" class="py-16 px-4 sm:px-6 lg:px-8 bg-white">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl sm:text-4xl font-bold text-slate-dark mb-4">
            Real Items. Real Profits.
          </h2>
          <p class="text-lg text-gray-600">
            These are actual items found and flipped by FlipProfit users
          </p>
        </div>

        <!-- Product Grid -->
        <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
          <!-- Item 1 -->
          <div class="bg-slate-light rounded-xl overflow-hidden shadow-lg hover:shadow-2xl transition-shadow">
            <div class="aspect-square">
              <img
                src="/images/Photo-of-item-flipped.jpg"
                alt="Flipped item - vintage collectible"
                class="w-full h-full object-cover"
              />
            </div>
            <div class="p-4">
              <div class="text-xs text-emerald-600 font-bold uppercase mb-1">Sold on eBay</div>
              <div class="text-sm text-gray-700 font-medium">Vintage Collectible</div>
              <div class="flex items-center gap-2 mt-2">
                <span class="text-xs text-gray-500">Cost: $8</span>
                <span class="text-xs text-gray-400">→</span>
                <span class="text-sm text-emerald-600 font-bold">Sold: $45</span>
              </div>
            </div>
          </div>

          <!-- Item 2 -->
          <div class="bg-slate-light rounded-xl overflow-hidden shadow-lg hover:shadow-2xl transition-shadow">
            <div class="aspect-square">
              <img
                src="/images/Photo-of-item-flipped-inpackage-item.jpg"
                alt="Flipped item - sealed package"
                class="w-full h-full object-cover"
              />
            </div>
            <div class="p-4">
              <div class="text-xs text-emerald-600 font-bold uppercase mb-1">Sold on Mercari</div>
              <div class="text-sm text-gray-700 font-medium">NIB Collectible</div>
              <div class="flex items-center gap-2 mt-2">
                <span class="text-xs text-gray-500">Cost: $12</span>
                <span class="text-xs text-gray-400">→</span>
                <span class="text-sm text-emerald-600 font-bold">Sold: $68</span>
              </div>
            </div>
          </div>

          <!-- Item 3 -->
          <div class="bg-slate-light rounded-xl overflow-hidden shadow-lg hover:shadow-2xl transition-shadow">
            <div class="aspect-square">
              <img
                src="/images/Photo-of-item-flipped-starwarsvhs.jpg"
                alt="Flipped item - Star Wars VHS"
                class="w-full h-full object-cover"
              />
            </div>
            <div class="p-4">
              <div class="text-xs text-emerald-600 font-bold uppercase mb-1">Sold on eBay</div>
              <div class="text-sm text-gray-700 font-medium">Star Wars VHS Set</div>
              <div class="flex items-center gap-2 mt-2">
                <span class="text-xs text-gray-500">Cost: $5</span>
                <span class="text-xs text-gray-400">→</span>
                <span class="text-sm text-emerald-600 font-bold">Sold: $32</span>
              </div>
            </div>
          </div>

          <!-- Finding Items Image - Spans 2 columns on desktop -->
          <div class="col-span-2 md:col-span-3 bg-gradient-to-br from-emerald-50 to-white rounded-xl overflow-hidden shadow-lg p-8">
            <div class="grid md:grid-cols-2 gap-8 items-center">
              <div>
                <img
                  src="/images/finding-item-in-store.jpg"
                  alt="Finding valuable items in store"
                  class="rounded-xl shadow-lg"
                />
              </div>
              <div>
                <div class="text-emerald-600 font-bold text-sm uppercase tracking-wider mb-2">The Hunt</div>
                <h3 class="text-2xl font-bold text-slate-dark mb-3">
                  The Best Part? Finding Hidden Gems
                </h3>
                <p class="text-gray-700 mb-4">
                  Every successful reseller knows that feeling when you spot an underpriced item. FlipProfit takes the guesswork out by showing you the data instantly.
                </p>
                <ul class="space-y-2 text-gray-700">
                  <li class="flex items-start gap-2">
                    <svg class="w-5 h-5 text-emerald-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                    <span>Scan while browsing shelves</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <svg class="w-5 h-5 text-emerald-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                    <span>See real sales data in 2 seconds</span>
                  </li>
                  <li class="flex items-start gap-2">
                    <svg class="w-5 h-5 text-emerald-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                    <span>Buy only profitable items</span>
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Founding Member Section -->
    <div class="bg-gradient-to-br from-emerald-50 via-white to-emerald-50">
      <ScarcityBanner />
    </div>

    <!-- SEO Content Section: How to Scale a Reselling Business -->
    <section id="features" class="py-16 px-4 sm:px-6 lg:px-8 bg-slate-light">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl sm:text-4xl font-bold text-slate-dark mb-6 text-center">
          How to Scale a Reselling Business
        </h2>

        <!-- Atomic Answer for Featured Snippet -->
        <div class="bg-white rounded-xl p-8 shadow-lg mb-12">
          <p class="text-lg text-gray-700 leading-relaxed">
            Scaling a reselling business requires implementing <strong class="text-emerald">automation</strong> across inventory management, cross-platform listing, and <strong class="text-emerald">sourcing</strong> workflows. Successful resellers systematize profit tracking, SKU organization, and multi-marketplace operations to reduce manual overhead. Tools like <strong class="text-emerald">FlipProfit</strong> enable this automation through centralized inventory control, bulk listing capabilities, and real-time analytics, allowing resellers to expand inventory volume without proportional time investment.
          </p>
        </div>

        <!-- Workflow Demonstration -->
        <div class="space-y-12">
          <!-- Step 1: At the Store -->
          <div class="grid md:grid-cols-2 gap-8 items-center">
            <div class="order-2 md:order-1">
              <div class="bg-emerald-100 text-emerald-700 text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full inline-block mb-4">
                Step 1: Sourcing
              </div>
              <h3 class="text-2xl font-bold text-slate-dark mb-4">Scout Items at the Store</h3>
              <p class="text-gray-700 mb-4">
                Open FlipProfit on your phone, scan any barcode, and instantly see:
              </p>
              <ul class="space-y-2 text-gray-700">
                <li class="flex items-start gap-2">
                  <svg class="w-5 h-5 text-emerald flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span>30-day eBay sold listings and average price</span>
                </li>
                <li class="flex items-start gap-2">
                  <svg class="w-5 h-5 text-emerald flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span>Amazon sales rank and pricing</span>
                </li>
                <li class="flex items-start gap-2">
                  <svg class="w-5 h-5 text-emerald flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span>Profit calculation after fees</span>
                </li>
              </ul>
            </div>
            <div class="order-1 md:order-2">
              <img
                src="/images/at-the-store.jpg"
                alt="Reseller scouting items at a thrift store"
                class="rounded-2xl shadow-xl w-full"
              />
            </div>
          </div>

          <!-- Step 2: Listing -->
          <div class="grid md:grid-cols-2 gap-8 items-center">
            <div>
              <img
                src="/images/holding-two-items-in-store.jpg"
                alt="Holding items ready to flip"
                class="rounded-2xl shadow-xl w-full"
              />
            </div>
            <div>
              <div class="bg-emerald-100 text-emerald-700 text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full inline-block mb-4">
                Step 2: Listing
              </div>
              <h3 class="text-2xl font-bold text-slate-dark mb-4">Create Listings in Seconds</h3>
              <p class="text-gray-700 mb-4">
                Take a photo of your item and let AI handle the heavy lifting:
              </p>
              <ul class="space-y-2 text-gray-700">
                <li class="flex items-start gap-2">
                  <svg class="w-5 h-5 text-emerald flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span>AI-generated SEO-optimized titles</span>
                </li>
                <li class="flex items-start gap-2">
                  <svg class="w-5 h-5 text-emerald flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span>Detailed descriptions with keywords</span>
                </li>
                <li class="flex items-start gap-2">
                  <svg class="w-5 h-5 text-emerald flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span>Suggested pricing based on market data</span>
                </li>
              </ul>
            </div>
          </div>

          <!-- Step 3: Tracking -->
          <div class="grid md:grid-cols-2 gap-8 items-center">
            <div class="order-2 md:order-1">
              <div class="bg-emerald-100 text-emerald-700 text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full inline-block mb-4">
                Step 3: Profit Tracking
              </div>
              <h3 class="text-2xl font-bold text-slate-dark mb-4">Track Every Dollar Automatically</h3>
              <p class="text-gray-700 mb-4">
                Sync your eBay account and let FlipProfit handle the rest:
              </p>
              <ul class="space-y-2 text-gray-700">
                <li class="flex items-start gap-2">
                  <svg class="w-5 h-5 text-emerald flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span>Automatic sales import from eBay</span>
                </li>
                <li class="flex items-start gap-2">
                  <svg class="w-5 h-5 text-emerald flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span>Real-time profit calculations (COGS, fees, shipping)</span>
                </li>
                <li class="flex items-start gap-2">
                  <svg class="w-5 h-5 text-emerald flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span>Tax-ready reports exportable to CSV</span>
                </li>
              </ul>
            </div>
            <div class="order-1 md:order-2">
              <img
                src="/images/profit-calc-screenshot.jpg"
                alt="FlipProfit profit tracking dashboard"
                class="rounded-2xl shadow-xl w-full border-4 border-emerald-200"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section id="faq" class="py-16 px-4 sm:px-6 lg:px-8 bg-white">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl sm:text-4xl font-bold text-slate-dark mb-4">
            Common Questions
          </h2>
          <p class="text-lg text-gray-600">
            Everything you need to know about FlipProfit
          </p>
        </div>

        <div class="space-y-6">
          <!-- FAQ 1 -->
          <div class="bg-slate-light rounded-xl p-6 shadow-md">
            <h3 class="text-lg font-bold text-slate-dark mb-3">Why not just use eBay and Amazon directly?</h3>
            <p class="text-gray-700">
              Searching eBay sold listings manually takes 2-3 minutes per item. FlipProfit shows you 30-day sales data, profit margins, and Amazon pricing in 2 seconds. When you're sourcing 20+ items in a trip, that's an hour saved every time you visit a thrift store.
            </p>
          </div>

          <!-- FAQ 2 -->
          <div class="bg-slate-light rounded-xl p-6 shadow-md">
            <h3 class="text-lg font-bold text-slate-dark mb-3">How accurate is the sales data?</h3>
            <p class="text-gray-700">
              FlipProfit pulls directly from eBay's API for sold listings and Amazon's product database. The data is as accurate as what you'd see manually searching these platforms—but delivered instantly. We show you actual sold prices, not just listed prices, so you know what items really sell for.
            </p>
          </div>

          <!-- FAQ 3 -->
          <div class="bg-slate-light rounded-xl p-6 shadow-md">
            <h3 class="text-lg font-bold text-slate-dark mb-3">What if I only flip part-time or don't have 50 items/month?</h3>
            <p class="text-gray-700">
              That's perfectly fine! Start with our free tier (5 scans/month) to test it out. Even if you're sourcing 10-20 items per month, the time savings and better buying decisions pay for themselves. Many part-time resellers use FlipProfit just for the scout feature when thrifting on weekends.
            </p>
          </div>

          <!-- FAQ 4 -->
          <div class="bg-slate-light rounded-xl p-6 shadow-md">
            <h3 class="text-lg font-bold text-slate-dark mb-3">Can I really cancel anytime?</h3>
            <p class="text-gray-700">
              Yes! No contracts, no commitments. Cancel from your account settings anytime. If you lock in the $45/year founding price and cancel later, you can reactivate at your locked-in rate anytime—the price lock is tied to your account forever.
            </p>
          </div>

          <!-- FAQ 5 -->
          <div class="bg-slate-light rounded-xl p-6 shadow-md">
            <h3 class="text-lg font-bold text-slate-dark mb-3">How much time does this actually save?</h3>
            <p class="text-gray-700">
              <strong>Sourcing:</strong> 90% faster than manual research (2 seconds vs 2-3 minutes per item)<br>
              <strong>Listing:</strong> AI-generated titles and descriptions save 5-10 minutes per listing<br>
              <strong>Tracking:</strong> Automatic eBay sync eliminates manual spreadsheet entry<br><br>
              Most users report saving 5-10 hours per week across their entire workflow.
            </p>
          </div>

          <!-- FAQ 6 -->
          <div class="bg-slate-light rounded-xl p-6 shadow-md">
