---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const {
  title,
  description,
  canonical = new URL(Astro.url.pathname, Astro.site).href,
  image = new URL('/images/logo.png', Astro.site).href,
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Pre-paint theme: resolve light/dark and apply `.dark` to <html> BEFORE
         first paint so there's no flash. Mirrors the app's ThemeContext exactly
         (same localStorage key + system/light/dark model) so the marketing site
         and the app feel like one product. `window.__fpTheme` is reused by the
         nav toggle. Note: localStorage isn't shared across the apex and app
         subdomains, so this tracks the visitor's choice on this site only. -->
    <script is:inline>
      (function () {
        var KEY = 'flipprofit-theme';
        var COLOR = { light: '#F9F9F9', dark: '#181818' };
        function prefersDark() {
          return !!(window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
        }
        function stored() {
          try {
            var s = localStorage.getItem(KEY);
            if (s === 'light' || s === 'dark' || s === 'system') return s;
          } catch (e) {}
          return 'system';
        }
        function resolve(t) { return t === 'system' ? (prefersDark() ? 'dark' : 'light') : t; }
        function apply(resolved) {
          document.documentElement.classList.toggle('dark', resolved === 'dark');
          var meta = document.querySelector('meta[name="theme-color"]');
          if (!meta) {
            meta = document.createElement('meta');
            meta.setAttribute('name', 'theme-color');
            document.head.appendChild(meta);
          }
          meta.setAttribute('content', COLOR[resolved]);
        }
        var api = window.__fpTheme = {
          get: stored,
          set: function (t) {
            try { localStorage.setItem(KEY, t); } catch (e) {}
            apply(resolve(t));
          },
          // System -> Light -> Dark -> System (matches the app's single-button cycle).
          cycle: function () {
            var t = stored();
            api.set(t === 'system' ? 'light' : t === 'light' ? 'dark' : 'system');
          },
        };
        apply(resolve(stored()));
        // While on 'system', follow live OS changes.
        if (window.matchMedia) {
          window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function () {
            if (stored() === 'system') apply(resolve('system'));
          });
        }
      })();
    </script>

    <link rel="icon" type="image/png" href="/favicon.png" />
    <!-- Preload the self-hosted wordmark font to avoid a flash on first paint. -->
    <link rel="preload" href="/fonts/coiny-latin-400.woff2" as="font" type="font/woff2" crossorigin />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Page-specific head content (e.g. JSON-LD structured data) -->
    <slot name="head" />

    <!-- Force any leftover service worker from the old app (once hosted at this
         apex domain) to check for its replacement immediately, so the
         self-destruct /sw.js can wipe the stale cached app on the next visit. -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.getRegistrations().then(function (regs) {
          regs.forEach(function (reg) { reg.update(); });
        });
      }
    </script>
  </head>

  <body class="bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100">
    <Nav />
    <slot />
    <Footer />
  </body>
</html>
