---
// Shared sticky navigation. Anchors use absolute "/#id" so the same links work
// from any page (subpages jump back to the homepage section).
const APP = 'https://app.flipprofit.online';
const JOIN = `${APP}/signup`;
---
<nav class="sticky top-0 z-50 bg-white/95 dark:bg-slate-900/95 backdrop-blur-sm border-b border-slate-200 dark:border-slate-800 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <a href="/" class="flex items-center gap-3 hover:opacity-80 transition-opacity">
        <img src="/images/logo-small.png" alt="FlipProfit" width="40" height="40" class="w-10 h-10" />
        <span class="font-coiny text-xl text-slate-dark">FlipProfit</span>
      </a>

      <!-- Desktop -->
      <div class="hidden md:flex items-center gap-6">
        <a href={APP} class="text-sm font-medium text-slate-600 dark:text-slate-300 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Browse</a>
        <a href="/#how" class="text-sm font-medium text-slate-600 dark:text-slate-300 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">How it works</a>
        <a href="/#sell" class="text-sm font-medium text-slate-600 dark:text-slate-300 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Sell</a>
        <a href="/#faq" class="text-sm font-medium text-slate-600 dark:text-slate-300 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">FAQ</a>
        <button type="button" data-theme-toggle aria-label="Toggle theme" class="p-2 rounded-lg text-slate-600 dark:text-slate-300 hover:text-emerald-600 dark:hover:text-emerald-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
          <svg data-icon="system" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2" stroke-width="2"></rect><path stroke-linecap="round" stroke-width="2" d="M8 21h8M12 17v4"></path></svg>
          <svg data-icon="light" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" stroke-width="2"></circle><path stroke-linecap="round" stroke-width="2" d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path></svg>
          <svg data-icon="dark" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
        </button>
        <a href={JOIN} class="px-5 py-2 bg-emerald text-white rounded-lg font-semibold text-sm hover:bg-emerald-600 transition-colors shadow-sm">
          Join the marketplace
        </a>
      </div>

      <!-- Mobile -->
      <div class="md:hidden flex items-center gap-2">
        <button type="button" data-theme-toggle aria-label="Toggle theme" class="p-2 rounded-lg text-slate-600 dark:text-slate-300 hover:text-emerald-600 dark:hover:text-emerald-400 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
          <svg data-icon="system" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2" stroke-width="2"></rect><path stroke-linecap="round" stroke-width="2" d="M8 21h8M12 17v4"></path></svg>
          <svg data-icon="light" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" stroke-width="2"></circle><path stroke-linecap="round" stroke-width="2" d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path></svg>
          <svg data-icon="dark" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
        </button>
        <a href={JOIN} class="px-4 py-2 bg-emerald text-white rounded-lg font-semibold text-sm hover:bg-emerald-600 transition-colors">
          Join
        </a>
      </div>
    </div>
  </div>
</nav>

<!-- Wire the theme toggle(s) to window.__fpTheme (defined pre-paint in Layout).
     Cycles System -> Light -> Dark and swaps the button icon to match. -->
<script is:inline>
  (function () {
    var buttons = document.querySelectorAll('[data-theme-toggle]');
    if (!buttons.length) return;
    var LABEL = { system: 'System', light: 'Light', dark: 'Dark' };
    function current() {
      return (window.__fpTheme && window.__fpTheme.get()) || 'system';
    }
    function render(theme) {
      buttons.forEach(function (btn) {
        btn.querySelectorAll('[data-icon]').forEach(function (el) {
          el.classList.toggle('hidden', el.getAttribute('data-icon') !== theme);
        });
        btn.setAttribute('title', LABEL[theme] + ' theme');
        btn.setAttribute('aria-label', 'Theme: ' + LABEL[theme] + '. Click to change.');
      });
    }
    render(current());
    buttons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        if (window.__fpTheme) window.__fpTheme.cycle();
        render(current());
      });
    });
  })();
</script>
