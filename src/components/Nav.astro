---
// Shared sticky navigation. Anchors use absolute "/#id" so the same links work
// from any page (subpages jump back to the homepage section).
const APP = 'https://app.flipprofit.online';
const JOIN = `${APP}/signup`;
---
<nav class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm border-b border-slate-200 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <a href="/" class="flex items-center gap-3 hover:opacity-80 transition-opacity">
        <img src="/images/logo-small.png" alt="FlipProfit" width="40" height="40" class="w-10 h-10" />
        <span class="font-coiny text-xl text-slate-dark">FlipProfit</span>
      </a>

      <!-- Desktop -->
      <div class="hidden md:flex items-center gap-6">
        <a href={APP} class="text-sm font-medium text-slate-600 hover:text-emerald-600 transition-colors">Browse</a>
        <a href="/#how" class="text-sm font-medium text-slate-600 hover:text-emerald-600 transition-colors">How it works</a>
        <a href="/#sell" class="text-sm font-medium text-slate-600 hover:text-emerald-600 transition-colors">Sell</a>
        <a href="/#faq" class="text-sm font-medium text-slate-600 hover:text-emerald-600 transition-colors">FAQ</a>
        <a href={JOIN} class="px-5 py-2 bg-emerald text-white rounded-lg font-semibold text-sm hover:bg-emerald-600 transition-colors shadow-sm">
          Join the marketplace
        </a>
      </div>

      <!-- Mobile -->
      <div class="md:hidden">
        <a href={JOIN} class="px-4 py-2 bg-emerald text-white rounded-lg font-semibold text-sm hover:bg-emerald-600 transition-colors">
          Join
        </a>
      </div>
    </div>
  </div>
</nav>
