---
// Astro version of ScarcityBanner for marketing site
// This will be hydrated on the client to enable real-time updates
---

<div id="scarcity-banner" class="hidden sticky top-0 z-50 bg-gradient-to-r from-emerald-600 via-emerald-500 to-emerald-600 text-white shadow-lg slide-down">
  <div class="max-w-7xl mx-auto px-4 py-3">
    <div class="flex items-center justify-center gap-3 text-center flex-wrap">
      <svg class="w-5 h-5 flex-shrink-0 animate-pulse" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z" clip-rule="evenodd"></path>
      </svg>

      <p class="text-sm sm:text-base font-semibold">
        <span class="inline-block">🎉 Founding Member Special:</span>
        {' '}
        <span class="inline-block">
          Only{' '}
          <span id="spots-remaining" class="inline-flex items-center justify-center min-w-[3ch] font-bold text-lg px-2 py-0.5 bg-white text-emerald-600 rounded-md transition-all duration-300">
            --
          </span>
          {' '}<span id="spots-text">spots</span> left to lock in{' '}
          <span class="font-bold underline decoration-2 underline-offset-2">$45/year for LIFE</span>
          {' '}(future price: $180/year)
        </span>
      </p>

      <a
        href="https://app.flipprofit.online/signup"
        class="inline-block bg-white text-emerald-600 px-4 py-1.5 rounded-lg font-bold text-sm hover:bg-emerald-50 transition-colors shadow-lg hover:shadow-xl whitespace-nowrap"
      >
        Lock In Price →
      </a>
    </div>
  </div>
</div>

<script>
  import { createClient } from '@supabase/supabase-js';

  const TOTAL_SPOTS = 500;
  const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
  const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

  // Initialize Supabase client
  const supabase = createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

  const banner = document.getElementById('scarcity-banner');
  const spotsElement = document.getElementById('spots-remaining');
  const spotsText = document.getElementById('spots-text');

  async function updateSpotCount() {
    try {
      const { data, error } = await supabase
        .rpc('get_total_user_count');

      if (error) throw error;

      const userCount = data || 0;
      const spotsRemaining = Math.max(0, TOTAL_SPOTS - userCount);

      if (spotsRemaining > 0) {
        spotsElement.textContent = spotsRemaining;
        spotsText.textContent = spotsRemaining === 1 ? 'spot' : 'spots';
        banner.classList.remove('hidden');
      } else {
        banner.classList.add('hidden');
      }

      return spotsRemaining;
    } catch (err) {
      console.error('Error fetching user count:', err);
      return null;
    }
  }

  // Initial load
  updateSpotCount();

  // Set up Realtime subscription
  const channel = supabase
    .channel('profiles-changes')
    .on(
      'postgres_changes',
      {
        event: 'INSERT',
        schema: 'public',
        table: 'profiles'
      },
      (payload) => {
        console.log('New user signed up:', payload);

        // Add animation class
        spotsElement.classList.add('scale-125', 'ring-4', 'ring-emerald-200');

        // Update count
        updateSpotCount();

        // Remove animation after 1 second
        setTimeout(() => {
          spotsElement.classList.remove('scale-125', 'ring-4', 'ring-emerald-200');
        }, 1000);
      }
    )
    .subscribe();
</script>

<style>
  @keyframes slideDown {
    from {
      transform: translateY(-100%);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  .slide-down {
    animation: slideDown 0.5s ease-out;
  }
</style>
