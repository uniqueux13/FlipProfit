---
// Founding Member section - OPTIMIZED FOR MOBILE LIVE STREAMING
// Perfect for 9:16 split-screen (counter top, face bottom)
---

<!-- Founding Member Section - Mobile Live Stream Optimized -->
<section id="founding-members" class="py-8 px-4">
  <div class="max-w-6xl mx-auto">
    <div class="grid lg:grid-cols-2 gap-8 items-start">
      <!-- Left: Founding Member Card -->
      <div class="lg:sticky lg:top-8">
        <!-- Compact Card for Streaming -->
        <div class="bg-white rounded-3xl shadow-2xl overflow-hidden border-4 border-emerald-500">

      <!-- Top: Counter -->
      <div class="bg-gradient-to-r from-emerald-600 to-emerald-500 px-6 py-5 text-center">
        <div class="mb-3">
          <div class="text-white/90 text-xs font-bold uppercase tracking-widest mb-1">Founding Member Offer</div>
          <div class="text-white text-sm font-medium">Limited to the first 500 members</div>
        </div>

        <!-- Pricing -->
        <div class="bg-white/10 backdrop-blur-sm rounded-xl px-5 py-2">
          <div class="flex items-baseline justify-center gap-2 mb-0.5">
            <span class="text-3xl font-black text-white">$45</span>
            <span class="text-base text-white/90 font-medium">/year</span>
          </div>
          <div class="text-white/90 text-xs">
            <span class="line-through">$180/year</span>
            <span class="ml-1 font-bold bg-white/20 px-1.5 py-0.5 rounded text-xs">75% off</span>
          </div>
        </div>
      </div>

      <!-- Middle: Simple Benefits -->
      <div class="px-6 py-3 bg-slate-50">
        <div class="text-center text-xs text-slate-600 mb-3">
          Full Access  •  Price Lock Forever  •  Cancel Anytime
        </div>
      </div>

      <!-- Bottom: CTAs -->
      <div class="px-6 pb-5 space-y-3">
        <!-- Primary Sign Up Button -->
        <a
          href="https://app.flipprofit.online/signup"
          class="block w-full text-center px-6 py-4 bg-emerald-600 text-white rounded-xl font-bold text-base hover:bg-emerald-700 transition-all shadow-lg hover:shadow-xl"
        >
          Start Free Today - 5 Scans Included
        </a>

        <!-- Secondary Discord Link -->
        <div class="text-center">
          <a
            href="https://discord.gg/nYj3UzdJ"
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm text-slate-600 hover:text-emerald-600 transition-colors inline-flex items-center gap-1"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.317 4.37a19.791 19.791 0 00-4.885-1.515.074.074 0 00-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 00-5.487 0 12.64 12.64 0 00-.617-1.25.077.077 0 00-.079-.037A19.736 19.736 0 003.677 4.37a.07.07 0 00-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 00.031.057 19.9 19.9 0 005.993 3.03.078.078 0 00.084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 00-.041-.106 13.107 13.107 0 01-1.872-.892.077.077 0 01-.008-.128 10.2 10.2 0 00.372-.292.074.074 0 01.077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 01.078.01c.12.098.246.198.373.292a.077.077 0 01-.006.127 12.299 12.299 0 01-1.873.892.077.077 0 00-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 00.084.028 19.839 19.839 0 006.002-3.03.077.077 0 00.032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 00-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
            </svg>
            Join Founder Community
          </a>
        </div>
      </div>
    </div>
      </div>

      <!-- Right: Why Lock In Your Price -->
      <div class="space-y-6">
        <div>
          <h3 class="text-2xl font-bold text-slate-dark mb-4">Why Lock In Your Founding Price?</h3>
          <p class="text-gray-700 mb-6">
            FlipProfit already has powerful features that competitors charge $180+/year for. As we continue building and improving, the price will increase to match the value. Founding members lock in $45/year for life.
          </p>
        </div>

        <div class="bg-white rounded-xl p-6 shadow-lg border-2 border-emerald-200">
          <h4 class="font-bold text-lg text-slate-dark mb-4">What You Get Right Now:</h4>
          <ul class="space-y-3">
            <li class="flex items-start gap-3">
              <div class="flex-shrink-0 w-6 h-6 bg-emerald-600 rounded-full flex items-center justify-center mt-0.5">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                </svg>
              </div>
              <div>
                <div class="font-semibold text-slate-dark">Direct eBay Integration</div>
                <p class="text-sm text-gray-600">Automatic sales sync, profit tracking, and order management</p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <div class="flex-shrink-0 w-6 h-6 bg-emerald-600 rounded-full flex items-center justify-center mt-0.5">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                </svg>
              </div>
              <div>
                <div class="font-semibold text-slate-dark">AI Listing Generator</div>
                <p class="text-sm text-gray-600">Upload photos, get SEO-optimized titles and descriptions instantly</p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <div class="flex-shrink-0 w-6 h-6 bg-emerald-600 rounded-full flex items-center justify-center mt-0.5">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                </svg>
              </div>
              <div>
                <div class="font-semibold text-slate-dark">Real-Time Profit Analytics</div>
                <p class="text-sm text-gray-600">Track COGS, fees, and net profit across your entire inventory</p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <div class="flex-shrink-0 w-6 h-6 bg-emerald-600 rounded-full flex items-center justify-center mt-0.5">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                </svg>
              </div>
              <div>
                <div class="font-semibold text-slate-dark">Mobile Scout Feature</div>
                <p class="text-sm text-gray-600">Scan items in-store, see 30-day eBay/Amazon data in 2 seconds</p>
              </div>
            </li>
          </ul>
        </div>

        <div class="bg-emerald-50 rounded-xl p-6 border-2 border-emerald-200">
          <div class="flex items-start gap-3">
            <svg class="w-6 h-6 text-emerald-600 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <div>
              <h4 class="font-bold text-slate-dark mb-2">The Founding Member Guarantee</h4>
              <p class="text-sm text-gray-700">
                Lock in $45/year now, and you'll pay this price forever—even as we add more features and increase the standard price to $180/year. No upgrades fees, no hidden costs. When we hit 500 founding members, this offer closes permanently.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

